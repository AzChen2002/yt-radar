# 複製成 .env 再填。.env 已在 .gitignore 裡，不會被提交。
# 已經在環境變數裡設過的值優先，.env 裡的同名項會被忽略。

# ---- YouTube Data API v3（官方、免費，每天 10,000 配額單位）----
# 1. 到 https://console.cloud.google.com 建一個專案
# 2. 「API 和服務」→「程式庫」→ 搜 YouTube Data API v3 → 啟用
# 3. 「憑證」→「建立憑證」→「API 金鑰」，貼到下面
# 不填也能跑，只是 YouTube 會跳過，只剩 GitHub、Hugging Face、Hacker News 和資訊 RSS（頁面會很空）。
YOUTUBE_API_KEY=
# 選用：限制搜尋地區和語言，例如 TW 和 zh-Hant。留空就是全球。
# YT_REGION=TW
# YT_LANG=zh-Hant
# 單次執行最多用掉的配額單位，到了就停止呼叫（一期完整執行約 3,000 到 5,000）
# YT_MAX_UNITS=9000

# ---- 模型（任何 OpenAI 相容的對話介面）----
# 預設 Google Gemini 免費層：到 https://aistudio.google.com 按「Get API key」就有，不用綁信用卡。
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# 其他免費選擇：
#   Groq 免費層：  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   本機 Ollama：  LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen3:14b   LLM_API_KEY=ollama
# 每次請求額外帶上的欄位（JSON），例如某些模型要關掉思考模式時：
# LLM_EXTRA_BODY={"reasoning_effort": "low"}
# 模型單價（每百萬 token，美元，「輸入,輸出」），只用來在執行記錄裡估算花費；免費層就是 0
# LLM_PRICE_USD_PER_M=0,0

# 選用：GitHub token。不填會先試 gh 指令的登入，再不行就匿名搜尋（限流較緊，偶爾少幾個倉庫）。
# GITHUB_TOKEN=

# 頁面上顯示的名字。出品方和點評口吻可以留空。
RADAR_SITE_NAME=AI 影片情報雷達
# RADAR_SITE_BY=你的社群名
# RADAR_EDITOR=寫點評的人

# 分享卡片 QR code 指向的網址，{day} 和 {item} 會被替換。頁面公開之後改成你的公開網址。
# RADAR_SHARE_URL=https://radar.example.com/#intel-radar?day={day}&item={item}

# 資料目錄（資料庫、產生的頁面、封面快取、日誌），預設 ~/.local/share/yt-radar
# RADAR_DATA_DIR=

# 本機預覽服務監聽的位址和埠
# RADAR_HOST=127.0.0.1
# RADAR_PORT=8792
